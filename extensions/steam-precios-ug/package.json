{
  "name": "steam-precios-ug",
  "private": true,
  "type": "module",
  "description": "Development tools and tests. The extension has no build step: load this folder as is.",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:live": "node --test \"tests/live/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:live && npm run test:e2e",
    "icons": "node tools/icons.mjs",
    "docs": "node tools/docs.mjs",
    "palette": "node design/exploration/palette.mjs"
  },
  "devDependencies": {
    "apca-w3": "^0.1.9",
    "axe-core": "^4.14.0",
    "culori": "^4.0.1",
    "puppeteer-core": "^25.17.0"
  }
}
